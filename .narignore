# SSPゴースト用 .narignore

# セーブデータ
/ghost/master/satori_savedata.txt
/ghost/master/satori_savebackup.txt

# ベースウェア等動作用ファイル
/ghost/master/profile/
/shell/master/profile/

# 追加シェル（shell/master以外のフォルダ）
/shell/*/
!/shell/master/

# 開発用のログ
/ghost/master/ssp_shiori_log.txt

# git・GitHub関連
/.git/
/.gitignore
/.gitattributes
/.gitmodules
/preview.gif
/readme.md

# 配布の設定とネットワーク更新ファイル（SSPが読み書きする。配布物には含めない）
/.narignore
/.updateignore
/updates.txt
/updates2.dau
# delete.txt はネットワーク更新でだけ使う（.updateignore で除外から外している）
/delete.txt

# 開発用のファイル（公開用リポジトリにはコピーしないが、開発フォルダでnarを作るときのため）
/.docs/
/.workspace/
/scripts/
/package.json
/.editorconfig

# その他の一時ファイル・システムファイル
*.tmp
*.log
*~
.DS_Store
Thumbs.db

# AIエージェント用の開発キット（配布物に含めない）
/AGENTS.md
/CLAUDE.md
/DEVKIT-GUIDE.md
/GHOST.md
/docs/agents/
/.mcp.json
/.claude/
/.github/
/tools/
# 開発キットのローカル出力（tools/devkit.narignore と同じ。公開用リポジトリには tools/ が無いので取り込まずに書く）
/build/
/ghost/master/devkit-balloon-*/
*.devkit-new
